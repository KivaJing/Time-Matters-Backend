{
  "ksqldb_url": "http://ksqldb:8088",
  "auto_offset_reset": "earliest",
  "cache_max_bytes_buffering": 0,
  "processing_guarantee": "at_least_once",
  "commit_interval_ms": 50,

  "raw_topic": "raw_state_events",
  "out_table": "risk_state_windows_new",
  "out_topic": "risk_state_windows_new",

  "window_size_sec": 25,
  "window_advance_sec": 5,
  "min_events": 1,
  "drop_output_topic": true,

  "notes": {
    "theoretical_model": "5-minute update cycle",
    "demo_compression": "SIM_MINUTE_SEC=5 gives 5 logical minutes = 25 seconds"
  }
}
